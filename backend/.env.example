# PromptTrace Backend Environment Configuration
# Copy this file to .env and configure for your environment

# Environment
ENV=development
DEBUG=true
LOG_LEVEL=INFO
RELOAD=false

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# LLM Models (HuggingFace identifiers)
# On CUDA/T4 machines, these defaults use a lightweight but stronger model.
# On CPU-only systems, distilgpt2 remains the safe fallback.
RESEARCH_AGENT_MODEL=Qwen/Qwen2.5-3B-Instruct
ANALYST_AGENT_MODEL=Qwen/Qwen2.5-3B-Instruct
ACTION_AGENT_MODEL=Qwen/Qwen2.5-3B-Instruct
PROPAGATION_MONITOR_MODEL=nvidia/Nemotron-3.5-Content-Safety

# Embedding Model
# BGE large is stronger on T4-class GPUs; BGE small is more conservative on CPU.
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Model Execution
# Set to cpu when no NVIDIA GPU/driver is available.
MODEL_DEVICE=cuda
MODEL_DTYPE=float16
MAX_SEQ_LENGTH=4096
BATCH_SIZE=8

# Generation Parameters
TEMPERATURE=0.7
TOP_P=0.95
TOP_K=50
MAX_NEW_TOKENS=2048

# RAG Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=128
RETRIEVAL_TOP_K=5
EMBEDDING_BATCH_SIZE=32

# File Paths
DATA_DIR=data
UPLOAD_DIR=data/uploads
INDEX_DIR=data/indices
LOGS_DIR=data/logs
CACHE_DIR=data/cache

# Vector Store
FAISS_METRIC=L2
FAISS_INDEX_TYPE=Flat

# Propagation Monitor
PROPAGATION_CONFIDENCE_THRESHOLD=0.6
MUTATION_DETECTION_ENABLED=true

# Timeouts (milliseconds)
LLM_TIMEOUT=300000
EMBEDDING_TIMEOUT=120000

# File Limits
MAX_PDF_SIZE_MB=50
MAX_CHUNKS_PER_QUERY=20
