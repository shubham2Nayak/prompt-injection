# PromptTrace Environment Configuration
# Copy to .env and customize for your deployment

# ─── Model Configuration ──────────────────────────────────────────────────────
# Two-model architecture:
#   Reasoning: Qwen/Qwen2.5-3B-Instruct (Research, Analyst, Action)
#   Annotation: nvidia/Nemotron-3.5-Content-Safety (Context Engine, Propagation Monitor)
#   Embedding: BAAI/bge-large-en-v1.5 (RAG)

RESEARCH_MODEL=Qwen/Qwen2.5-3B-Instruct
ANALYST_MODEL=Qwen/Qwen2.5-3B-Instruct
ACTION_MODEL=Qwen/Qwen2.5-3B-Instruct
ANNOTATION_MODEL=nvidia/Nemotron-3.5-Content-Safety
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ─── Device & Precision ──────────────────────────────────────────────────────
MODEL_DEVICE=cuda
# bfloat16, not float16: the Nemotron safety model is Gemma-3 based and returns
# an all-NaN logit tensor in float16, which makes it emit padding tokens forever
# instead of a verdict. models/gpu_budget pins Gemma-family models to bfloat16
# regardless of this value.
MODEL_DTYPE=bfloat16
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

ANNOTATION_DEVICE=cuda

# ─── GPU Memory Budget ────────────────────────────────────────────────────────
# The three resident models (bge-large 0.62 GiB + Nemotron 7.23 GiB + Qwen 5.75 GiB
# = 13.6 GiB of fp16 weights) do not fit a 16 GB T4. At startup the backend reads
# the VRAM actually free and picks the highest-fidelity plan that fits, quantizing
# the reasoning model before the safety annotation model. Leave these unset to let
# it decide automatically.
#
# VRAM held back for the CUDA context, the KV cache of both LLMs and transient
# activation buffers, so resident weights never fill the card.
GPU_RESERVE_GB=2.0
# Optional per-slot overrides, comma separated. Modes: fp16 | int8 | nf4 | cpu.
# GPU_LOAD_MODE_OVERRIDES=reasoning=nf4,annotation=int8

# ─── Generation Temperatures ─────────────────────────────────────────────────
# Reasoning models
TEMPERATURE_RESEARCH=0.2
TEMPERATURE_ANALYST=0.1
TEMPERATURE_ACTION=0.0
# Annotation model (deterministic)
TEMPERATURE_ANNOTATION=0.0

# Shared generation params
TOP_P=0.95
TOP_K=50
MAX_NEW_TOKENS=2048
MAX_SEQ_LENGTH=4096

# ─── RAG Configuration ──────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=128
RETRIEVAL_TOP_K=5
BATCH_SIZE=8
EMBEDDING_BATCH_SIZE=32
ANNOTATION_BATCH_SIZE=32

# ─── Propagation Monitor ────────────────────────────────────────────────────
PROPAGATION_CONFIDENCE_THRESHOLD=0.6
MUTATION_DETECTION_ENABLED=true

# ─── File Paths ──────────────────────────────────────────────────────────────
DATA_DIR=data
UPLOAD_DIR=data/uploads
INDEX_DIR=data/indices
LOGS_DIR=data/logs
CACHE_DIR=data/cache

# ─── API Configuration ──────────────────────────────────────────────────────
ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
RELOAD=false

# ─── Timeouts ────────────────────────────────────────────────────────────────
LLM_TIMEOUT=300
EMBEDDING_TIMEOUT=120

# ─── System Limits ───────────────────────────────────────────────────────────
MAX_PDF_SIZE_MB=50
MAX_CHUNKS_PER_QUERY=20

# ─── Vector Store ────────────────────────────────────────────────────────────
FAISS_METRIC=L2
FAISS_INDEX_TYPE=Flat